# =============================================================================
# Frontend Environment Configuration
# =============================================================================

# Backend API Base URL
# When deploying to Render (as a Static Site), set this to your Render backend web service URL:
# Example: https://rfq-backend.onrender.com/api/v1
#
# For local development with Vite dev proxy (vite.config.ts), leave this UNSET or empty.
# In that case, client.ts automatically falls back to /api/v1 which is proxied to http://localhost:8000.
VITE_API_BASE_URL=https://rfq-backend.onrender.com/api/v1
