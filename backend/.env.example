# =============================================================================
# Backend Environment Configuration
# =============================================================================

# Database URL (PostgreSQL - Neon or Cloud Hosted Postgres)
# Replace with your Neon connection string from the Neon Dashboard (Connection details -> Pooled connection).
# Neon connection strings support both postgres:// and postgresql:// and sslmode=require.
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis URL (Upstash Redis - Celery Broker ONLY)
# PostgreSQL remains the single source of truth for auction state; Redis is strictly used as the Celery task broker.
# Upstash connection string uses the TLS rediss:// scheme.
REDIS_URL=rediss://default:your_upstash_password@sample-endpoint.upstash.io:6379

# Allowed CORS Origins (comma-separated list of allowed origins)
# Include your local frontend development server URLs and your deployed Render frontend URL.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://rfq-frontend.onrender.com
